# Kopieren nach .env und mit echten Werten befüllen.
# .env selbst wird nie committet (siehe .gitignore).

# true im deployten Produktivbetrieb, sonst false
PRODUCTION=false

# Collection-Präfix zur Trennung von Test- und Produktivdaten in Firestore
PREFIX=T-

# true, um lokal gegen die Firebase-Emulatoren statt gegen die echten
# Firebase-Dienste zu laufen
USE_EMULATORS=false

# Firebase-Projektkonfiguration (Firebase Console > Projekteinstellungen)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Microsoft-Entra-Tenant-ID für den Microsoft-Login
MS_TENANT=
