# Kopieren nach .env und mit echten Werten befüllen.
# .env selbst wird nie committet (siehe .gitignore).

# true im deployten Produktivbetrieb, sonst false
PRODUCTION=false

# Basis-URL des NestJS-Backends (api/), REST + WebSocket-Namespace /kicker
API_URL=http://localhost:3000

# Microsoft-Entra-Tenant-ID und Client-ID der SPA-App-Registrierung für den
# Login (Auth Code Flow + PKCE, siehe auth.service.ts). Werte kommen aus der
# App-Registrierung im evia-Tenant (Azure Portal > Entra ID > App registrations).
# ENTRA_AUDIENCE ist die Application-ID-URI/Client-ID der API-App-Registrierung
# (muss der aud-Claim der Access Tokens sein, siehe api/.env.example).
MS_TENANT=
MS_CLIENT_ID=
ENTRA_AUDIENCE=

# Nur für lokale Entwicklung ohne echte App-Registrierung: überspringt den
# kompletten Login-Flow (siehe auth.service.ts). Niemals außerhalb der
# lokalen Entwicklung setzen. docker-compose.override.yml setzt das bereits.
DISABLE_SSO=false

# Nur für `docker compose up` (docker-compose.yml). Postgres publiziert
# keinen Port nach außen (nur innerhalb des Docker-Netzwerks erreichbar),
# daher reicht hier ein einfacher Default - für einen produktiven Betrieb
# außerhalb einer lokalen Maschine trotzdem austauschen.
POSTGRES_USER=kicker
POSTGRES_PASSWORD=kicker-local-dev

# Herkunft, von der der Browser die API anspricht (CORS). Statischer
# Schlüssel für POST /kicker/status vom Kickertisch - frei wählen, per
# Passwort-Generator erzeugen, da extern (auf dem Tisch) hinterlegt.
CORS_ORIGIN=http://localhost:8080
KICKER_API_KEY=

# Öffentlicher VAPID-Schlüssel für Web Push. Wird über config.json an den
# Browser ausgeliefert (siehe generate-config.js). Erzeugen mit:
#   cd api && node -e "console.log(require('web-push').generateVAPIDKeys())"
# Der private Schlüssel des Paares gehört ausschließlich in api/.env.
VAPID_PUBLIC_KEY=
