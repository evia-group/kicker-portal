# Kopieren nach .env und mit echten Werten befüllen. .env wird nie committet.

PORT=3000

# CORS-Origin des Frontends. In Produktion die konkrete Origin statt "true" setzen.
CORS_ORIGIN=http://localhost:4200

# PostgreSQL-Verbindung, siehe docker-compose.yml (folgt in Phase 8) für den
# Hostnamen des db-Containers.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kicker

# Statischer Schlüssel, den der physische Kickertisch bei POST /kicker/status
# im Header x-api-key mitschickt. Frei wählen, per Passwort-Generator erzeugen.
KICKER_API_KEY=

# Pfad zu einem Firebase-Service-Account-JSON (Firebase Console > Projekt-
# einstellungen > Dienstkonten). Wird von firebase-admin für die Verifikation
# der Auth-Tokens benötigt, solange Phase 6 (Entra ID) noch nicht umgesetzt ist.
GOOGLE_APPLICATION_CREDENTIALS=
