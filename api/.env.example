# Kopieren nach .env und mit echten Werten befüllen. .env wird nie committet.

PORT=3000

# CORS-Origin des Frontends. In Produktion die konkrete Origin statt "true" setzen.
CORS_ORIGIN=http://localhost:4200

# PostgreSQL-Verbindung. Host ist "db" statt "localhost", wenn über
# docker-compose.yml gestartet (dort bereits automatisch gesetzt).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kicker

# Statischer Schlüssel, den der physische Kickertisch bei POST /kicker/status
# im Header x-api-key mitschickt. Frei wählen, per Passwort-Generator erzeugen.
KICKER_API_KEY=

# Pfad zu einem Firebase-Service-Account-JSON (Firebase Console > Projekt-
# einstellungen > Dienstkonten). Nur noch für scripts/migrate-from-firebase.ts
# und scripts/verify-migration.ts gebraucht (lesen aus Firestore) - der
# laufende Server verifiziert Auth-Tokens seit Phase 6 nicht mehr über
# Firebase, sondern über Entra ID (siehe unten).
GOOGLE_APPLICATION_CREDENTIALS=

# Microsoft-Entra-Tenant, gegen den Auth-Tokens verifiziert werden (JWKS unter
# https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys).
ENTRA_TENANT_ID=

# Application ID URI bzw. Client-ID der API-App-Registrierung - muss der
# `aud`-Claim der vom Frontend gesendeten Access Tokens sein.
ENTRA_AUDIENCE=

# Nur für lokale Entwicklung ohne echte App-Registrierung: überspringt die
# Token-Verifikation komplett, jede Anfrage wird als fixer lokaler
# Admin-Nutzer authentifiziert (siehe EntraAuthGuard). Niemals außerhalb der
# lokalen Entwicklung setzen. docker-compose.override.yml setzt das bereits.
AUTH_DISABLED=false

# VAPID-Schlüsselpaar für Web Push. Der öffentliche Schlüssel muss mit dem in
# der Frontend-.env übereinstimmen, sonst weist der Browser die Registrierung
# ab. Erzeugen mit:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Fehlt eine der drei Angaben, läuft die Anwendung ohne Benachrichtigungen
# weiter (siehe NotificationsService).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontaktadresse für den Push-Dienst, mailto: oder https:
VAPID_SUBJECT=mailto:kicker@evia.de
