# Kopieren nach .env und mit echten Werten befüllen. .env wird nie committet.

PORT=3000

# CORS-Origin des Frontends. In Produktion die konkrete Origin statt "true" setzen.
CORS_ORIGIN=http://localhost:4200

# PostgreSQL-Verbindung, siehe docker-compose.yml (folgt in Phase 8) für den
# Hostnamen des db-Containers.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kicker

# Statischer Schlüssel, den der physische Kickertisch bei POST /kicker/status
# im Header x-api-key mitschickt. Frei wählen, per Passwort-Generator erzeugen.
KICKER_API_KEY=

# Pfad zu einem Firebase-Service-Account-JSON (Firebase Console > Projekt-
# einstellungen > Dienstkonten). Nur noch für scripts/migrate-from-firebase.ts
# und scripts/verify-migration.ts gebraucht (lesen aus Firestore) - der
# laufende Server verifiziert Auth-Tokens seit Phase 6 nicht mehr über
# Firebase, sondern über Entra ID (siehe unten).
GOOGLE_APPLICATION_CREDENTIALS=

# Microsoft-Entra-Tenant, gegen den Auth-Tokens verifiziert werden (JWKS unter
# https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys).
ENTRA_TENANT_ID=

# Application ID URI bzw. Client-ID der API-App-Registrierung - muss der
# `aud`-Claim der vom Frontend gesendeten Access Tokens sein.
ENTRA_AUDIENCE=
